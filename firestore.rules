rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid));
    }

    function getUserRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role;
    }

    function hasRole(orgId, roles) {
      return isOrgMember(orgId) && getUserRole(orgId) in roles;
    }

    match /organizations/{orgId} {

      // 🔒 ONLY members can read org
      allow read: if isOrgMember(orgId);

      // 🔒 ONLY admins/owners can modify org
      allow write: if hasRole(orgId, ['admin', 'owner']);

      match /users/{userId} {

        // 🔒 Only org members can read users
        allow read: if isOrgMember(orgId);

        // 🔒 NO client-side role modification
        allow create: if false;

        // 🔒 Users can update limited fields on themselves ONLY
        allow update: if request.auth.uid == userId
          && isOrgMember(orgId)
          && !('role' in request.resource.data);

        // 🔒 Admins manage users
        allow delete: if hasRole(orgId, ['admin', 'owner']);
      }

      match /clients/{clientId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /appointments/{appointmentId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /quotes/{quoteId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /documents/{documentId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /inventory/{itemId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /communications/{commId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }
    }
  }
}

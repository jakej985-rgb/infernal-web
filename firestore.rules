rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid));
    }

    function getUserRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role;
    }

    function hasRole(orgId, roles) {
      return isOrgMember(orgId) && getUserRole(orgId) in roles;
    }

    function isSystemAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/organizations/default-org/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/organizations/default-org/users/$(request.auth.uid)).data.email == 'admin.ink.steel@gmail.com' ||
         get(/databases/$(database)/documents/organizations/default-org/users/$(request.auth.uid)).data.email == 'admin@inkandsteel.xyz');
    }

    match /requests/{requestId} {
      allow create: if request.resource.data.status == 'pending';
      allow read: if isSystemAdmin() || resource != null;
      allow update: if isSystemAdmin() || (
        resource.data.status == 'approved' && 
        request.resource.data.status == 'claimed' &&
        request.resource.data.inviteToken == resource.data.inviteToken
      );
      allow delete: if isSystemAdmin();
    }

    match /users/{userId} {
      // 🔒 Allow read globally to support resolving username to email before login
      allow read: if true;
      
      // 🔒 Allow users to write their own mapping, or admins of the target organization
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (
          request.resource != null && 
          exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)/users/$(request.auth.uid)).data.role in ['admin', 'owner']
        )
      ) && (
        request.resource.data.email is string &&
        request.resource.data.username is string &&
        request.resource.data.orgId is string
      );
    }

    match /organizations/{orgId} {

      // 🔒 ONLY members can read org
      allow read: if isOrgMember(orgId);

      // 🔒 ONLY admins/owners can modify org, or authenticated users creating it
      allow write: if hasRole(orgId, ['admin', 'owner']) || (request.auth != null && resource == null);

      match /users/{userId} {

        // 🔒 Allow users to read their own profile, or if org member
        allow read: if request.auth.uid == userId || isOrgMember(orgId);

        // 🔒 Allow users to create their own profile document
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.email is string
          && request.resource.data.username is string;

        // 🔒 Users can update limited fields on themselves ONLY
        allow update: if request.auth.uid == userId
          && isOrgMember(orgId)
          && !('role' in request.resource.data);

        // 🔒 Admins manage users
        allow delete: if hasRole(orgId, ['admin', 'owner']);
      }

      // 🔒 Private Integration Secrets: ONLY accessible via Admin SDK / Cloud Functions
      match /integration_private/{docId} {
        allow read, write: if false;
      }

      // 🔒 Shop Settings
      match /settings/{settingsId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['admin', 'owner']);
      }

      match /clients/{clientId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /appointments/{appointmentId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /quotes/{quoteId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /documents/{documentId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /inventory/{itemId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }

      match /communications/{commId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ['artist', 'admin', 'owner']);
      }
    }
  }
}

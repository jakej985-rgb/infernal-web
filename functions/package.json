    "googleapis": "^122.0.0",
    "nodemailer": "^6.9.3"
  },
  "devDependencies": {
    "@types/node": "^18.16.19",
    "@types/nodemailer": "^6.4.8",
    "typescript": "^5.1.6"
  },
  "private": true
}
